/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS and JS are kept for a week. Every link to them carries ?v=<content hash>, set by
# scripts/stamp-versions.py, so a changed file gets a new address and is downloaded at once.
# A week (not a year, not "immutable") means a forgotten stamp heals by itself within 7 days.
# Move to "max-age=31536000, immutable" only once a failed --check blocks deploys (see README).
/*.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800

# The service worker must always be fresh. "! Cache-Control" drops the /*.js rule above.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

# The icon font files and fa.css (rebuilt and versioned by scripts/build-fa-subset.py; they
# change only when that script runs). "! Cache-Control" removes the /*.css rule from fa.css.
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/components/*
  X-Robots-Tag: noindex

# Header, footer, search box and search data, fetched by shared.js with ?v=<content hash>.
# A week, like CSS/JS above. (Listed by name, not /components/*, so the .js files there keep
# the /*.js rule.)
/components/navbar
  Cache-Control: public, max-age=604800

/components/footer
  Cache-Control: public, max-age=604800

/components/search
  Cache-Control: public, max-age=604800

/search-index.json
  Cache-Control: public, max-age=604800
  X-Robots-Tag: noindex

# Keep the pages.dev copies of the site out of search results (the canonical site is www.bac-story.com)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
