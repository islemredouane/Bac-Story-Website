/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/components/*
  X-Robots-Tag: noindex

# Header, footer and search box: loaded by shared.js on every page.
# Browsers keep them 1 hour, then show the saved copy instantly while fetching
# a fresh one in the background (up to 1 day). To publish a change at once,
# bump the ?v= number for that file in components/shared.js.
# (Listed by name, not /components/*, so the .js files there keep their own rule.)
/components/navbar
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/components/footer
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/components/search
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/search-index.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Robots-Tag: noindex

# Keep the pages.dev copies of the site out of search results (the canonical site is www.bac-story.com)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
