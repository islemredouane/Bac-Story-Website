#!/bin/sh
# Checks run before every commit. Enable once per clone:  git config core.hooksPath .githooks

# 1. ?v= links must match the files they point to (see scripts/stamp-versions.py).
if ! python3 scripts/stamp-versions.py --check >/dev/null 2>&1; then
    python3 scripts/stamp-versions.py --check
    echo
    echo "Commit stopped: run  python3 scripts/stamp-versions.py  then  git add -A  and commit again."
    exit 1
fi

# 2. Every font is served from /fonts (Tajawal/Pattaya in style.css, Amiri/Cairo in
#    fonts/amiri-cairo.css). A page copied from an old template can bring a Google Fonts link back.
bad=$(grep -rl --include='*.html' 'fonts.googleapis.com' . \
      | grep -v -e '^./.git/' -e '^./node_modules/' -e '^./.github/' 2>/dev/null)
if [ -n "$bad" ]; then
    echo "$bad"
    echo
    echo "Commit stopped: these pages load fonts from Google Fonts. Remove that <link> (and its"
    echo "<noscript>): the fonts are served from /fonts (see README, Design system)."
    exit 1
fi
exit 0
