#!/bin/sh
# Refuses a commit whose ?v= links are out of date (see scripts/stamp-versions.py).
# Enable once per clone:  git config core.hooksPath .githooks
python3 scripts/stamp-versions.py --check >/dev/null 2>&1 && exit 0
python3 scripts/stamp-versions.py --check
echo
echo "Commit stopped: run  python3 scripts/stamp-versions.py  then  git add -A  and commit again."
exit 1
