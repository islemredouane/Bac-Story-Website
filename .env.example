# ─────────────────────────────────────────────────────────────────
# BAC STORY — Environment Variables (template)
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's in .gitignore.
# ─────────────────────────────────────────────────────────────────

# Supabase — get from supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...                   # public, safe in frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...           # SECRET, server-only

# Gemini — get from aistudio.google.com → API keys
GEMINI_API_KEY=AIza...

# CORS — production frontend origin (e.g. https://bacstory.com)
# Leave blank in local dev (server.js sets CORS to *)
ALLOWED_ORIGIN=

# Resend — for email OTP. Get from resend.com → API keys
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev

# Telegram — for Telegram OTP. Get from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
