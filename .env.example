# Copy this file to .env for local dev. Set these in Vercel dashboard for production.

# Supabase
SUPABASE_URL=https://vfjjrpzdyvawthvkwelr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── AI PROVIDER ROTATION ────────────────────────────────────────────────────
# The router tries providers in order: all Gemini keys → all Groq keys → OpenRouter.
# Each key that hits its rate limit gets a 65-second cooldown; the next key takes over.
# Add more numbered keys for more capacity — all are free tier.

# Gemini 2.0 Flash (PRIMARY — free at aistudio.google.com/apikey)
# Free: 1,000,000 tok/min, 1,500 req/day per key. Supports up to 10 keys.
# Use GEMINI_API_KEY_1 … GEMINI_API_KEY_10 (or plain GEMINI_API_KEY as fallback)
GEMINI_API_KEY_1=your_gemini_key_1_here
# GEMINI_API_KEY_2=second_google_account_key
# GEMINI_API_KEY_3=third_google_account_key
# GEMINI_API_KEY_4=fourth_google_account_key
# GEMINI_API_KEY_5=fifth_google_account_key
# GEMINI_API_KEY_6=sixth_google_account_key
# GEMINI_API_KEY_7=seventh_google_account_key
# GEMINI_API_KEY_8=eighth_google_account_key

# Groq — Llama 3.3 70B (FALLBACK — free at console.groq.com)
# Free: 6,000 tok/min, 14,400 req/day per key. Supports up to 10 keys.
# GROQ_API_KEY is always used first; then GROQ_API_KEY_2 … GROQ_API_KEY_10
GROQ_API_KEY=your_groq_key_here
# GROQ_API_KEY_2=second_groq_account_key
# GROQ_API_KEY_3=third_groq_account_key
# GROQ_API_KEY_4=fourth_groq_account_key
# GROQ_API_KEY_5=fifth_groq_account_key
# GROQ_API_KEY_6=sixth_groq_account_key
# GROQ_API_KEY_7=seventh_groq_account_key
# GROQ_API_KEY_8=eighth_groq_account_key

# OpenRouter (LAST RESORT — free at openrouter.ai, multiple free models)
# Each key unlocks 3 free models (Gemini Flash, Llama 70B, Mistral 7B). Supports up to 5 keys.
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_API_KEY_2=second_openrouter_key_here
